# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_style = space

[*.sh]
indent_style = space

[*.y{a,}ml]
indent_style = space
indent_size = 2

[LICENSE]
indent_style = unset
indent_size = unset

# TODO: Take a decisive stance on tabs vs spaces
[*.{m,}{t,j}s{x,}]
indent_size = 2
indent_style = space

[*.{json,css,html}]
indent_style = space
indent_size = 2

[/{.github,.devcontainer}/**.json]
indent_style = tab
